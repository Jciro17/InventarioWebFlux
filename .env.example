# Plantilla de configuración de Inventario UCO.
#
# 1. Copia este archivo con el nombre .env, en esta misma carpeta (junto al pom.xml).
# 2. Reemplaza solo los valores que están vacíos.
# El archivo .env NO se sube a Git (está en .gitignore). Nunca subas tus secretos.

# Client ID de la identidad de servicio de tu aplicación.
# Se crea en la consola de seguridad: Identidades de servicio > Identidades > Crear identidad.
# Empieza por svc-
MESSAGEUCOLAB_CLIENT_ID=

# Secreto de esa identidad (client_secret). La consola lo muestra una sola vez al crearla.
MESSAGEUCOLAB_CLIENT_SECRET=

# Dirección de MessageUcoLab (la de Kong). Si lo tienes en este mismo equipo, déjala así.
MESSAGEUCOLAB_URL=http://localhost:8000

# Opcional: dirección donde Keycloak entrega tokens. Si usas la instalación local del componente de
# seguridad, no la cambies (se quita el # solo si tu Keycloak está en otra dirección).
# KEYCLOAK_TOKEN_URI=http://keycloak.localhost:19090/realms/security-baseline/protocol/openid-connect/token
